{\pard\sb300\sa120{\f1\fs26\b\cf2 5. Credentials & Security}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab OAuth 2.0 client credentials and refresh token stored in a local {\f2\fs18 .env} file, excluded from version control via {\f2\fs18 .gitignore}}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab Developer token stored server-side only, never exposed in client-facing code}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab No end-user credentials are collected or stored}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab All API calls are read-only; no write or mutate operations are performed}\par}
{\pard\li360\sa200{\f1\fs20\bullet\tab A pre-commit secret scanner (gitleaks) is configured to prevent accidental credential commits}\par}

{\pard\sb300\sa120{\f1\fs26\b\cf2 6. Data Handling & Retention}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab Raw API responses stored locally as Parquet files, labeled with collection date}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab All volume data marked {\f2\fs18 is_bucketed = true} (Google Ads rounds search volumes)}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab No personally identifiable information is collected from the API}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab Data used solely for internal market research; not resold, shared, or published at keyword level}\par}
{\pard\li360\sa200{\f1\fs20\bullet\tab Outputs are aggregated trend and cluster reports, not raw keyword-level disclosures}\par}

{\pard\sb300\sa120{\f1\fs26\b\cf2 7. Compliance Statement}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab This tool is used exclusively by Mejores Rese\u241?as for internal research; no third-party client accounts are accessed}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab The tool performs zero advertising operations (no campaigns, bids, or ads created or modified)}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab Fake review generation, review gating, and purchased reviews are explicitly excluded from the product scope by design}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab All usage is intended to comply with the Google Ads API Terms of Service and Developer Program Policies}\par}
{\pard\li360\sa200{\f1\fs20\bullet\tab The customer ID used is the developer舗?s own Google Ads account (ID: 3889381999), not a managed client account}\par}

{\pard\sb300\sa120{\f1\fs26\b\cf2 8. Technical Stack}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab {\b Language:} Python 3.12}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab {\b Google Ads library:} {\f2\fs18 google-ads} v31 (official PyPI package)}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab {\b Authentication:} OAuth 2.0 via {\f2\fs18 google-auth-oauthlib}}\par}
{\pard\li360\sa60{\f1\fs20\bullet\tab {\b Storage:} Apache Parquet (raw) + DuckDB (analytics)}\par}
{\pard\li360\sa200{\f1\fs20\bullet\tab {\b Environment:} Local development machine; no cloud deployment of API credentials}\par}

